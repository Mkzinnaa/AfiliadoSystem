# Copy this file to .env for local use. Never commit the real .env.
VERTICE_DB_DRIVER=mysql
VERTICE_DB_HOST=127.0.0.1
VERTICE_DB_PORT=3306
VERTICE_DB_NAME=
VERTICE_DB_USER=
VERTICE_DB_PASSWORD=

# Localhost enables the demo when this is unset. Set false in production.
VERTICE_SETUP_KEY=

# Public HTTPS URL and optional comma-separated mobile/web origins.
VERTICE_APP_URL=
VERTICE_API_ALLOWED_ORIGINS=capacitor://localhost
VERTICE_COOKIE_SECURE=

# Optional SMTP settings. Allowed encryption values: tls, ssl, none.
VERTICE_SMTP_HOST=
VERTICE_SMTP_PORT=587
VERTICE_SMTP_ENCRYPTION=tls
VERTICE_SMTP_USERNAME=
VERTICE_SMTP_PASSWORD=
VERTICE_SMTP_FROM_EMAIL=
VERTICE_SMTP_FROM_NAME=AFFILIEY
