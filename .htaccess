# If the hosting account must use the repository root as document root,
# serve only the public/ directory. Prefer setting the domain document root
# directly to public/ in cPanel.
Options -Indexes
<FilesMatch "(^\.env(?:\..*)?$|^\.user\.ini$|^error_log$)">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^public/ - [L]
RewriteRule ^(.*)$ public/$1 [L]
