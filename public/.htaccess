Options -Indexes -MultiViews
AddType application/manifest+json .webmanifest
DirectoryIndex index.php

RewriteEngine On

# The admin subdomain opens the protected master console by default.
RewriteCond %{HTTP_HOST} ^admin\.affiliey\.com$ [NC]
RewriteRule ^$ platform-admin-login.php [L]

# Keep public API and webhook routes stable.
RewriteRule ^api(?:/|$) - [L]
RewriteRule ^webhook\.php$ - [L]

# Preserve extensionless public URLs as the canonical form.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

# Resolve extensionless page URLs to their PHP implementation.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

<FilesMatch "(^\.|^error_log$|\.(ini|log|sqlite|sqlite3|db|bak|backup|sql)$)">
  Require all denied
</FilesMatch>
